{
  "name": "artex-desktop",
  "version": "2.2.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.cjs",
    "package": "node scripts/package.cjs",
    "package:installer": "node scripts/package.cjs --installer",
    "package:signed": "node scripts/package.cjs --signed",
    "test:distribution": "node --test distribution-tests/*.test.cjs",
    "test:backup": "node --test backup-tests/*.test.cjs",
    "test:installed": "node --test distribution-tests/installed.integration.cjs",
    "test:electron": "playwright test",
    "test:package": "playwright test --config playwright.package.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.6.0"
  }
}
